# Zep Cloud — https://app.getzep.com
ZEP_API_KEY=

# OpenAI — GPT-5.6 for the insight engine
OPENAI_API_KEY=

# Optional: Luna is the low-cost default for the constrained insight decision.
# Set to gpt-5.6-terra or gpt-5.6-sol to use a stronger tier.
INSIGHT_MODEL=gpt-5.6-luna

# Demo REST API bearer token (set a non-empty value before running uvicorn)
API_KEY=

# Optional comma-separated browser origins for the local Next.js demo UI.
CORS_ORIGINS=http://localhost:3000

# Optional: default tenant used by seed.py / local testing
DEFAULT_TENANT_ID=demo-school
